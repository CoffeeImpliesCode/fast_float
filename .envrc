# direnv entry point for the fast_float Zig SDK.
#
# `devenv` is the canonical development environment for this SDK: devenv.nix
# defines it and devenv.yaml pins its one input. This file does nothing except
# hand a shell that already has direnv over to it. It defines no environment
# variable, no path and no cache location of its own -- the scratch and cache
# policy belongs to the environment this shell is entered from, and to
# devenv.nix's own resolution of it at shell entry.
#
# Nothing here is required. `devenv shell` alone is enough, and it is the
# supported path; this is a convenience for a direnv-enabled shell.
#
# direnv is not installed by this repository. If it is missing, the shell says
# so rather than falling back to something else.
if ! has devenv; then
  echo "fast_float: devenv is not on PATH; this repository's development shell is entered with 'devenv shell', or by installing direnv." >&2
  return 1
fi

use devenv